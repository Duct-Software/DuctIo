/**
 * @file duct_build_config.h
 * @brief Build-time configuration. Generated by CMake — do not edit.
 */

#ifndef DUCT_BUILD_CONFIG_H
#define DUCT_BUILD_CONFIG_H

#include <stddef.h>
#include <stdint.h>

@DUCT_PLATFORM_CONFIG_LINES@

/* Defaults disabled; cmake/platform/mingw.cmake overrides via DUCT_PLATFORM_CONFIG_LINES. */
#ifndef DUCT_TIMER_NO_HIRES
#define DUCT_TIMER_NO_HIRES 1
#endif

/* Pool and per-object sizing. */
[[maybe_unused]] constexpr unsigned duct_runtime_max_conns     = @DUCT_RUNTIME_MAX_CONNS@u;
[[maybe_unused]] constexpr unsigned duct_runtime_max_listeners = @DUCT_RUNTIME_MAX_LISTENERS@u;
/* Fixed, not a cmake tunable: the WFQ/session multiplexing design only
 * supports up to this many io reactor threads. Single source of truth for
 * every "how many io threads can this engine have" check/array in the tree. */
[[maybe_unused]] constexpr unsigned duct_runtime_max_io_threads = 2u;
[[maybe_unused]] constexpr unsigned duct_runtime_max_workers   = 64u;
/* Least descriptor limit a full engine runs under: one per conn of the pool, one per
   listener slot, the events and wake descriptors of each io thread, and the three
   stdio streams. duct_ctor stops a POSIX process whose limit stays below it. */
[[maybe_unused]] constexpr unsigned duct_runtime_max_fds       =
    duct_runtime_max_conns + duct_runtime_max_listeners + 2u * duct_runtime_max_io_threads + 3u;
[[maybe_unused]] constexpr unsigned duct_session_max_legs      = @DUCT_SESSION_MAX_LEGS@u;
[[maybe_unused]] constexpr unsigned duct_session_max_streams   = @DUCT_SESSION_MAX_STREAMS@u;
[[maybe_unused]] constexpr size_t   duct_conn_tx_olb_cap       = @DUCT_CONN_TX_OLB_CAP@u;
/* >= 2 × duct_udp4_payload_max, so recv_threshold
   (duct_olb_rx_threshold_set) clears a full datagram without relying on
   the olb_rx_th_div cap to shrink it first. */
[[maybe_unused]] constexpr size_t   duct_conn_rx_olb_cap       = @DUCT_CONN_RX_OLB_CAP@u;
/* Per-worker lane capacity for a listener's dgram_tx_outbox. Under
   sustained load this lane fills and every worker's commit hits
   commit_internal, so its size gates achievable throughput directly,
   not just retry frequency. */
[[maybe_unused]] constexpr size_t   duct_dgram_tx_outbox_cap   = @DUCT_DGRAM_TX_OUTBOX_LANE_CAP@u;
/* Kernel SO_RCVBUF requested for datagram sockets, decoupled from the RX
   OLB cap: the kernel queue is the only slack that absorbs an io-thread
   scheduling gap, so it must cover milliseconds of ingress, not one OLB
   round. Takes effect only up to net.core.rmem_max — Linux clamps the
   request silently. */
[[maybe_unused]] constexpr size_t   duct_dgram_sock_rcvbuf     = @DUCT_DGRAM_SOCK_RCVBUF@u;
/* Kernel SO_SNDBUF requested for a datagram listener's socket and a Windows
   x_udp_peer dial: the slack that carries a stall in the NIC taking packets. A
   send it refuses hands every later datagram to the io thread until that
   drains. Takes effect only up to net.core.wmem_max — Linux clamps the request
   silently. A Linux x_udp_peer dial asks duct_x_dgram_truesize per datagram of
   a TX batch. */
[[maybe_unused]] constexpr size_t   duct_dgram_sock_sndbuf     = @DUCT_DGRAM_SOCK_SNDBUF@u;
[[maybe_unused]] constexpr uint32_t duct_dgram_rx_slots        = @DUCT_DGRAM_RX_SLOTS@u;
[[maybe_unused]] constexpr uint32_t duct_dgram_rx_batch        = @DUCT_DGRAM_RX_BATCH@u;
[[maybe_unused]] constexpr uint32_t duct_dgram_tx_batch        = @DUCT_DGRAM_TX_BATCH@u;
[[maybe_unused]] constexpr uint64_t duct_dgram_batch_wait_ns   = @DUCT_DGRAM_BATCH_WAIT_US@ull * 1000ull;
[[maybe_unused]] constexpr unsigned duct_dgram_rx_max_passes   = @DUCT_DGRAM_RX_MAX_PASSES@u;
[[maybe_unused]] constexpr size_t   duct_cacheline_size        = @DUCT_CACHELINE_SIZE@u;

/* Longest spin on one idle stretch, shared by the worker loop and every events
   model, cut to the park price below; each loop picks its spin within it from
   the gaps it has seen. */
[[maybe_unused]] constexpr uint64_t duct_busy_spin_ns          = @DUCT_BUSY_SPIN_US@ull * 1000ull;
/* Price of one park and wake, in spin nanoseconds; no loop spins longer, and 0
   parks at once. A wake costs most on a virtual guest, where a parked loop's
   vCPU halts until the host scheduler runs it again. */
[[maybe_unused]] constexpr uint64_t duct_spin_gap_cutoff_ns    = @DUCT_SPIN_GAP_CUTOFF_US@ull * 1000ull;

/* Thread-to-cpu binding. Worth turning off wherever the cores are not also
   reserved from the scheduler: pinning without isolation hands every DPC and
   interrupt on that cpu straight to the pinned thread. */
[[maybe_unused]] constexpr bool     duct_thread_pinning        = @DUCT_THREAD_PINNING@ != 0;
[[maybe_unused]] constexpr bool     duct_thread_pin_io_first   = @DUCT_PIN_IO_FIRST@ != 0;

/* Timer wheel. */
[[maybe_unused]] constexpr uint64_t duct_timer_coalesce_us     = @DUCT_TIMER_COALESCE_US@u;
[[maybe_unused]] constexpr unsigned duct_timer_hash_bits       = @DUCT_TIMER_HASH_BITS@u;
[[maybe_unused]] constexpr unsigned duct_timer_trim_threshold  = @DUCT_TIMER_TRIM_THRESHOLD@u;

/* Coroutine pools and coop quotas. */
[[maybe_unused]] constexpr unsigned duct_coro_stack_slots      = @DUCT_CORO_STACK_SLOTS@u;
[[maybe_unused]] constexpr unsigned duct_coro_sl_slots         = @DUCT_CORO_SL_SLOTS@u;
[[maybe_unused]] constexpr size_t   duct_coro_stack_bytes      = @DUCT_CORO_STACK_BYTES@u;
[[maybe_unused]] constexpr unsigned duct_coro_cycle_quota      = @DUCT_CORO_CYCLE_QUOTA@u;
[[maybe_unused]] constexpr unsigned duct_async_cycle_quota     = @DUCT_ASYNC_CYCLE_QUOTA@u;

/* WFQ drain budgets. */
[[maybe_unused]] constexpr unsigned duct_wfq_quota_fast        = @DUCT_WFQ_QUOTA_FAST@u;
[[maybe_unused]] constexpr unsigned duct_wfq_quota_norm        = @DUCT_WFQ_QUOTA_NORM@u;
[[maybe_unused]] constexpr unsigned duct_wfq_quota_bg          = @DUCT_WFQ_QUOTA_BG@u;
[[maybe_unused]] constexpr size_t   duct_wfq_byte_quota_norm   = @DUCT_WFQ_BYTE_QUOTA_NORM@u;

[[maybe_unused]] constexpr bool     duct_handshake_mask        = @DUCT_HANDSHAKE_MASK@ != 0;

#endif /* DUCT_BUILD_CONFIG_H */
