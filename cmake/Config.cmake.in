@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(DuctIo_WITH_OPENSSL @DuctIo_WITH_OPENSSL@)
set(DuctIo_WITH_NOISE @DuctIo_WITH_NOISE@)
set(DuctIo_EVENTS_MODEL "@DuctIo_EVENTS_MODEL@")

# The static target links OpenSSL with either crypto adapter; resolve it before loading the targets.
if(DuctIo_WITH_OPENSSL OR DuctIo_WITH_NOISE)
    find_dependency(OpenSSL)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/DuctIoTargets.cmake")

check_required_components(ductio)
